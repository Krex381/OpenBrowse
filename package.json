{
  "name": "openbrowse",
  "version": "0.1.0",
  "private": true,
  "description": "Secure, self-hosted, HTTP-first browser execution gateway",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "npm run build:server && npm run build:landing",
    "build:server": "tsc -p tsconfig.json",
    "build:landing": "vite build --config vite.landing.config.ts",
    "dev:landing": "vite --config vite.landing.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run tests/unit tests/security",
    "pretest:integration": "npm run build:landing",
    "test:integration": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run tests/integration/browserless-compat.test.ts tests/integration/http.test.ts tests/integration/mcp.test.ts tests/integration/search.test.ts --maxWorkers=1 --no-file-parallelism",
    "test:raw-bridge": "node scripts/test-raw-bridge.mjs",
    "test:all": "npm run test && npm run test:integration && npm run test:raw-bridge",
    "verify:new-features": "node scripts/verify-new-features.mjs",
    "verify:docker": "node scripts/verify-docker.mjs",
    "verify:benchmark-smoke": "node scripts/verify-benchmark-smoke.mjs",
    "benchmark:soak": "node scripts/soak-benchmark.mjs",
    "benchmark:corpus": "node scripts/extraction-corpus-benchmark.mjs"
  },
  "dependencies": {
    "@fastify/swagger": "^9.4.0",
    "@fastify/websocket": "^11.2.0",
    "@novnc/novnc": "^1.7.0",
    "cheerio": "^1.1.2",
    "fastify": "^5.6.1",
    "graphql": "^16.12.0",
    "lighthouse": "^13.4.1",
    "lucide-react": "^1.31.0",
    "playwright": "^1.57.0",
    "prom-client": "^15.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "undici": "^7.16.0",
    "ws": "^8.18.3",
    "yazl": "3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.0.8"
  }
}
