OPENBROWSE_HOST=0.0.0.0
OPENBROWSE_PORT=3000
# Optional public http(s) address used when returning WebSocket URLs behind a reverse proxy. A path prefix is supported.
OPENBROWSE_EXTERNAL_URL=
# Optional comma-separated exact browser origins permitted for CORS. Empty disables CORS.
OPENBROWSE_CORS_ALLOWED_ORIGINS=
# Where Playwright browser binaries are installed. Keep this aligned with the install command below.
PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers
OPENBROWSE_API_KEYS=replace-with-a-long-random-api-key
# Permit the hardened client launch-options subset on browser WebSocket routes.
# Allowed flags include viewport, language, selected Chromium feature switches, rendering, and GPU toggles.
OPENBROWSE_ALLOW_CLIENT_LAUNCH_OPTIONS=false
# Required in production. Set false only for local Windows development where
# Chromium user namespaces are unavailable.
OPENBROWSE_CHROMIUM_SANDBOX=true
# Lighthouse bypasses the normal request-interception path. Keep this disabled
# unless its browser worker is isolated with an egress policy.
OPENBROWSE_LIGHTHOUSE_ENABLED=false
# Raw CDP/Playwright sockets can bypass application URL guards. Keep disabled
# unless the browser worker has a separately enforced egress policy.
OPENBROWSE_RAW_BROWSER_PROTOCOL_BRIDGES=false
# Cache is shared. Leave global purge disabled unless this route is restricted
# by an operator-managed API key policy.
OPENBROWSE_CACHE_PURGE_ENABLED=false
# Optional mandatory outbound proxy for browser and HTTP target traffic. This
# proxy must enforce destination IP policy after DNS resolution.
OPENBROWSE_EGRESS_PROXY_URL=
# Optional JSON policy list. Policy keys are added to OPENBROWSE_API_KEYS, may be scoped to routes,
# and can override rateLimitPerMinute and dailyRequestLimit per key.
# OPENBROWSE_API_KEY_POLICIES=[{"key":"reporting-key","name":"reporting","allowedRoutes":["/v1/usage"],"rateLimitPerMinute":60,"dailyRequestLimit":1000}]
# Optional per-API-key daily request quota. 0 disables the quota.
OPENBROWSE_DAILY_REQUEST_LIMIT=0
OPENBROWSE_DATA_DIR=./data
OPENBROWSE_MAX_CONCURRENCY=4
OPENBROWSE_BROWSER_POOL_MIN=0
OPENBROWSE_BROWSER_POOL_MAX=2
# Maximum concurrent BrowserContexts per Chromium process.
OPENBROWSE_BROWSER_CONTEXTS_PER_WORKER=4
# Drain a worker after repeated context-creation failures; use exponential restart backoff.
OPENBROWSE_BROWSER_WORKER_FAILURE_LIMIT=3
OPENBROWSE_BROWSER_LAUNCH_BACKOFF_MS=1000
OPENBROWSE_MEMORY_SOFT_MB=1536
OPENBROWSE_MEMORY_HARD_MB=1900
OPENBROWSE_MEMORY_RESERVE_MB=256
OPENBROWSE_BROWSER_MAX_JOBS=200
OPENBROWSE_BROWSER_MAX_AGE_MS=1800000
OPENBROWSE_BROWSER_RECYCLE_RSS_MB=900
OPENBROWSE_QUEUE_MAX=100
OPENBROWSE_JOB_TIMEOUT_MS=30000
OPENBROWSE_PAGE_MAX=4
OPENBROWSE_CACHE_MEMORY_MB=64
OPENBROWSE_CACHE_DISK_MB=2048
OPENBROWSE_MAX_RESPONSE_BYTES=10485760
OPENBROWSE_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Optional SearXNG-compatible JSON endpoint, e.g. https://search.example/search
OPENBROWSE_SEARCH_ENDPOINT=
# Optional Browserless-style operator GET alerts. They are SSRF-validated, best effort, and throttled to one per event per minute.
OPENBROWSE_QUEUE_ALERT_URL=
OPENBROWSE_REJECT_ALERT_URL=
OPENBROWSE_TIMEOUT_ALERT_URL=
OPENBROWSE_ERROR_ALERT_URL=
OPENBROWSE_FAILED_HEALTH_URL=
# Maximum persistent/session lifetime in seconds. Defaults to 1 day; may be raised to 7,776,000 (90 days).
OPENBROWSE_MAX_SESSION_TTL_SECONDS=86400
# Optional path-delimited, administrator-managed unpacked Chromium extension directories.
# Example on Windows: C:\\openbrowse\\extensions\\adblock;C:\\openbrowse\\extensions\\company-tools
OPENBROWSE_CHROMIUM_EXTENSION_DIRS=
# Internal WebSocket URL for the authenticated noVNC bridge. Docker config supplies this.
OPENBROWSE_VNC_BRIDGE_URL=
