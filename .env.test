PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers
OPENBROWSE_EXTERNAL_URL=https://openbrowse.example.test/edge
OPENBROWSE_CORS_ALLOWED_ORIGINS=https://console.example.test
OPENBROWSE_API_KEYS=dev-key,other-key
OPENBROWSE_ENCRYPTION_KEY=test-encryption-key-for-encrypted-profile-fixtures
OPENBROWSE_ALLOW_CLIENT_LAUNCH_OPTIONS=true
OPENBROWSE_CHROMIUM_SANDBOX=false
OPENBROWSE_LIGHTHOUSE_ENABLED=true
OPENBROWSE_RAW_BROWSER_PROTOCOL_BRIDGES=false
OPENBROWSE_MAX_SESSION_TTL_SECONDS=7776000
OPENBROWSE_API_KEY_POLICIES=[{"key":"reporting-key","name":"reporting","allowedRoutes":["/v1/usage"],"rateLimitPerMinute":60,"dailyRequestLimit":100000}]
